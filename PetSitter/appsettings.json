{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "AllowedOrigins": [
        "http://localhost:5138"
    ],
    "ConnectionStrings": {
        "MongoDb": "YOUR_MONGODB_CONNECTION_STRING",
        "Database": "YOUR_MONGODB_DATABASE",
        "DefaultConnection": "YOUR_DEFAULT_CONNECTION"
    },
    "JwtSettings": {
        "Secret": "YOUR_JWT_SECRET",
        "PreviousSecrets": [],
        "Issuer": "PetSitterApp",
        "Audience": "PetSitterUsers",
        "ExpirationMinutes": 1440
    },
    "StayUpdates": {
        "MaxPerBooking": 30,
        "MaxPhotoBytes": 2097152,
        "RequireStayDates": false
    },
    "RateLimiting": {
        "AuthStrictLimit": 5
    },
    "AccountLockout": {
        "MaxFailedAttempts": 5,
        "LockoutMinutes": 15
    },
    "SmtpSettings": {
        "Host": "localhost",
        "Port": 1025,
        "User": "",
        "Password": "",
        "FromName": "PawStay Pet Care",
        "FromEmail": "no-reply@pawstay.vn",
        "UseSsl": false,
        "Enabled": false
    },
    "ForwardedHeaders": {
        "KnownProxies": [],
        "KnownNetworks": []
    },
    "BankStatementMapping": {
        "DateColumn": "NgayGiaoDich",
        "DescriptionColumn": "MoTa",
        "AmountColumn": "SoTien",
        "ReferenceColumn": "MaThamChieu"
    },
    "BookingSettings": {
        "CompletionDeadlineDays": 3
    },
    "NotificationSettings": {
        "TtlDays": 90
    },
    "BookingReminderSettings": {
        "PendingExpiringHours": 12,
        "CompletionExpiringHours": 24,
        "MaxOverdueAcceptedReminders": 7,
        "MinScanIntervalMinutes": 5
    },
    "BookingMaintenance": {
        "IntervalMinutes": 10,
        "AutoCompletionPendingAfterDays": 7,
        "ReminderDays": [ 0, 1, 2, 3 ],
        "ReconcileLookbackDays": 7,
        "ReconcileLimit": 100,
        "Enabled": true
    },
    "Security": {
        "DataProtectionKeyPath": "C:\\ProgramData\\PetSitter\\dp_keys"
    },
    "Payments": {
        "PayoutMode": "MANUAL",
        "PayoutsEnabled": false,
        "WithdrawMin": 50000,
        "WithdrawDailyLimit": 20000000,
        "BankChangeCooldownHours": 24,
        "GatewayFeePerTransaction": 0,
        "PayoutFeePerTransaction": 0,
        "RevenueReserveHours": 48,
        "ClaimTimeoutMinutes": 30,
        "PayosPlanQuota": 100,
        "PayosPlanUsedBaseline": 5,
        "QuotaWarningRemaining": 15
    },
    "CspSettings": {
        "EnforceMode": false
    }
}
