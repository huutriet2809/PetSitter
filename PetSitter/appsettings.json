{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "AllowedOrigins": [
        "http://localhost:5138"
    ],
    "ConnectionStrings": {
        "MongoDb": "YOUR_MONGODB_CONNECTION_STRING",
        "Database": "YOUR_MONGODB_DATABASE",
        "DefaultConnection": "YOUR_DEFAULT_CONNECTION"
    },
    "JwtSettings": {
        "Secret": "YOUR_JWT_SECRET",
        "Issuer": "PetSitterApp",
        "Audience": "PetSitterUsers",
        "ExpirationMinutes": 1440
    },
    "StayUpdates": {
        "MaxPerBooking": 30,
        "MaxPhotoBytes": 2097152,
        "RequireStayDates": false
    },
    "RateLimiting": {
        "AuthStrictLimit": 5
    },
    "ForwardedHeaders": {
        "KnownProxies": []
    },
    "BookingSettings": {
        "CompletionDeadlineDays": 3
    },
    "NotificationSettings": {
        "TtlDays": 90
    },
    "BookingReminderSettings": {
        "PendingExpiringHours": 12,
        "CompletionExpiringHours": 24,
        "MaxOverdueAcceptedReminders": 7,
        "MinScanIntervalMinutes": 5
    },
    "Security": {
        "DataProtectionKeyPath": "C:\\ProgramData\\PetSitter\\dp_keys"
    },
    "Payments": {
        "PayoutMode": "MANUAL",
        "PayoutsEnabled": false,
        "WithdrawMin": 50000,
        "WithdrawDailyLimit": 20000000,
        "BankChangeCooldownHours": 24,
        "GatewayFeePerTransaction": 0,
        "PayoutFeePerTransaction": 0,
        "RevenueReserveHours": 48,
        "ClaimTimeoutMinutes": 30,
        "PayosPlanQuota": 100,
        "PayosPlanUsedBaseline": 5,
        "QuotaWarningRemaining": 15
    }
}
